<Page x:Class="Presentation.ConducteurMainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1E1E2F">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--SIDEBAR -->
        <StackPanel Background="#111827">

            <TextBlock Text="Conducteur"
                       Foreground="White"
                       FontSize="20"
                       Margin="20"/>

            <Button Content="Dashboard"
                    Click="Dashboard_Click"/>

            <Button Content="Mes Trajets"
                    Click="Trajets_Click"/>

            <Button Content="Réservations"
                    Click="Reservations_Click"/>
            <Button Content="Mes Voitures"
        Click="Voitures_Click"/>

            <Button Content="Logout"
                    Click="Logout_Click"
                    Background="#EF233C"/>

        </StackPanel>

        <!-- CONTENT -->
        <Frame x:Name="MainFrame"
               Grid.Column="1"/>

    </Grid>
</Page>