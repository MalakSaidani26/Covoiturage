<Page x:Class="Presentation.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1E1E2F">

    <Grid>
        <Border Width="400"
                Padding="30"
                CornerRadius="15"
                Background="#2C2C3E"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="Connexion"
                           FontSize="26"
                           Foreground="White"
                           Margin="0,0,0,20"
                           HorizontalAlignment="Center"/>

                <!-- Email -->
                <TextBlock Text="Email" Foreground="LightGray"/>
                <TextBox x:Name="txtEmail" Height="40" Margin="0,5,0,10"/>

                <!-- Password -->
                <TextBlock Text="Mot de passe" Foreground="LightGray"/>
                <PasswordBox x:Name="txtPassword" Height="40" Margin="0,5,0,10"/>

                <!-- Buttons -->
                <Button Content="Se connecter"
                        Background="#3A86FF"
                        Foreground="White"
                        Height="40"
                        Click="Login_Click"/>

                <Button Content="Retour"
                        Background="#444"
                        Foreground="White"
                        Height="35"
                        Margin="0,10"
                        Click="Back_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>