<Page x:Class="Presentation.MesReservationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1E1E2F">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📦" FontSize="26" Margin="0,0,10,0"/>
                <TextBlock Text="Mes Réservations"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"/>
            </StackPanel>

            <!-- BACK -->
            <Button Grid.Column="1"
                    Content="← Retour"
                    Background="#3A86FF"
                    Foreground="White"
                    Padding="10,5"
                    BorderThickness="0"
                    Click="Back_Click"/>
        </Grid>

        <!-- TABLE -->
        <Border Grid.Row="1"
                Background="#2C2C3E"
                CornerRadius="12"
                Padding="10"
                Margin="0,0,0,20">

            <DataGrid x:Name="resGrid"
                      AutoGenerateColumns="False"
                      Background="Transparent"
                      Foreground="White"
                      RowBackground="#2C2C3E"
                      AlternatingRowBackground="#262638"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column">

                <!-- HEADER STYLE -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#3A3A50"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Trajet"
                        Binding="{Binding Trajet.AdresseDepart}" Width="*"/>

                    <DataGridTextColumn Header="Destination"
                        Binding="{Binding Trajet.AdresseArrivee}" Width="*"/>

                    <DataGridTextColumn Header="Conducteur"
                        Binding="{Binding Trajet.NomCompletConducteur}" Width="*"/>

                    <DataGridTextColumn Header="Places"
                        Binding="{Binding NbPlaces}" Width="*"/>

                    <DataGridTextColumn Header="Prix (TND)"
                        Binding="{Binding Prix}" Width="*"/>

                    <DataGridTextColumn Header="Statut"
                        Binding="{Binding Statut}" Width="*"/>

                </DataGrid.Columns>

            </DataGrid>
        </Border>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal">

            <Button Content="🔄 Actualiser"
                    Background="#555"
                    Foreground="White"
                    Padding="10,5"
                    Margin="5"
                    BorderThickness="0"
                    Click="Refresh_Click"/>

            <Button Content="❌ Annuler"
                    Background="#EF233C"
                    Foreground="White"
                    Padding="10,5"
                    Margin="5"
                    BorderThickness="0"
                    Click="Delete_Click"/>

        </StackPanel>

    </Grid>
</Page>