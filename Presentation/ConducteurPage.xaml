<Page x:Class="Presentation.ConducteurPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1E1E2F">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="🚗" FontSize="28" Margin="0,0,10,0"/>
            <TextBlock Text="Mes Trajets"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"/>
        </StackPanel>

        <!-- TABLE -->
        <Border Grid.Row="1"
                Background="#2C2C3E"
                CornerRadius="12"
                Padding="10"
                Margin="0,0,0,20">

            <DataGrid x:Name="trajetGrid"
                      AutoGenerateColumns="False"
                      Background="Transparent"
                      Foreground="White"
                      RowBackground="#2C2C3E"
                      AlternatingRowBackground="#262638"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      SelectionChanged="trajetGrid_SelectionChanged">

                <!-- HEADER STYLE -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#3A3A50"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- CELL STYLE -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Départ" Binding="{Binding AdresseDepart}" Width="*"/>
                    <DataGridTextColumn Header="Arrivée" Binding="{Binding AdresseArrivee}" Width="*"/>

                    <!--  Date + Heure -->
                    <DataGridTextColumn Header="Date"
                        Binding="{Binding DateDepart, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}"
                        Width="*"/>

                    <DataGridTextColumn Header="Durée" Binding="{Binding DureeMinutes}" Width="*"/>
                    <DataGridTextColumn Header="Voiture" Binding="{Binding Voiture.Modele}" Width="*"/>
                </DataGrid.Columns>

            </DataGrid>
        </Border>

        <!-- FORM -->
        <Border Grid.Row="2"
                Background="#2C2C3E"
                CornerRadius="12"
                Padding="20">

            <StackPanel>

                <TextBlock Text="Ajouter / Modifier un trajet"
                           Foreground="White"
                           FontSize="18"
                           Margin="0,0,0,15"/>

                <WrapPanel>

                    <StackPanel Margin="10">
                        <TextBlock Text="Départ" Foreground="LightGray"/>
                        <TextBox x:Name="txtDepart" Width="140" Padding="5"/>
                    </StackPanel>

                    <StackPanel Margin="10">
                        <TextBlock Text="Arrivée" Foreground="LightGray"/>
                        <TextBox x:Name="txtArrivee" Width="140" Padding="5"/>
                    </StackPanel>

                    <StackPanel Margin="10">
                        <TextBlock Text="Durée (min)" Foreground="LightGray"/>
                        <TextBox x:Name="txtDuree" Width="100" Padding="5"/>
                    </StackPanel>

                    <!-- DATE -->
                    <StackPanel Margin="10">
                        <TextBlock Text="Date" Foreground="LightGray"/>
                        <DatePicker x:Name="dpDate" Width="160"/>
                    </StackPanel>

                    <!-- HEURE -->
                    <StackPanel Margin="10">
                        <TextBlock Text="Heure (HH:mm)" Foreground="LightGray"/>
                        <TextBox x:Name="txtHeure" Width="100" Padding="5"/>
                    </StackPanel>

                    <!-- VOITURE -->
                    <StackPanel Margin="10">
                        <TextBlock Text="Voiture" Foreground="LightGray"/>
                        <ComboBox x:Name="cmbVoiture"
                                  Width="160"
                                  DisplayMemberPath="Modele"/>
                    </StackPanel>

                </WrapPanel>

                <!-- BUTTONS -->
                <StackPanel Orientation="Horizontal" Margin="10,20,0,0">

                    <Button Content="➕ Ajouter"
                            Background="#3A86FF"
                            Foreground="White"
                            Padding="12,6"
                            Margin="5"
                            BorderThickness="0"
                            Click="Add_Click"/>

                    <Button Content="✏ Modifier"
                            Background="#FFBE0B"
                            Foreground="Black"
                            Padding="12,6"
                            Margin="5"
                            BorderThickness="0"
                            Click="Edit_Click"/>

                    <Button Content="🗑 Supprimer"
                            Background="#EF233C"
                            Foreground="White"
                            Padding="12,6"
                            Margin="5"
                            BorderThickness="0"
                            Click="Delete_Click"/>

                </StackPanel>

            </StackPanel>
        </Border>

    </Grid>
</Page>