<Page x:Class="Presentation.VoiturePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1E1E2F">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="🚗" FontSize="26" Margin="0,0,10,0"/>
            <TextBlock Text="Mes Voitures"
                       Foreground="White"
                       FontSize="26"
                       FontWeight="Bold"/>
        </StackPanel>

        <!-- TABLE CARD -->
        <Border Grid.Row="1"
                Background="#2C2C3E"
                CornerRadius="12"
                Padding="10"
                Margin="0,0,0,20">

            <DataGrid x:Name="voitureGrid"
                      AutoGenerateColumns="False"
                      Background="Transparent"
                      Foreground="White"
                      RowBackground="#2C2C3E"
                      AlternatingRowBackground="#262638"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      SelectionChanged="voitureGrid_SelectionChanged">

                <!-- HEADER STYLE -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#3A3A50"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- CELL STYLE -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Marque" Binding="{Binding Marque}" Width="*"/>
                    <DataGridTextColumn Header="Modèle" Binding="{Binding Modele}" Width="*"/>
                    <DataGridTextColumn Header="Couleur" Binding="{Binding Couleur}" Width="*"/>
                    <DataGridTextColumn Header="Places" Binding="{Binding NbPlacesTotal}" Width="*"/>
                    <DataGridTextColumn Header="Immatriculation" Binding="{Binding Immatriculation}" Width="*"/>
                </DataGrid.Columns>

            </DataGrid>
        </Border>

        <!-- FORM CARD -->
        <Border Grid.Row="2"
                Background="#2C2C3E"
                CornerRadius="12"
                Padding="20">

            <StackPanel>

                <TextBlock Text="Ajouter / Modifier une voiture"
                           Foreground="White"
                           FontSize="18"
                           Margin="0,0,0,15"/>

                <WrapPanel>

                    <StackPanel Margin="10">
                        <TextBlock Text="Marque" Foreground="LightGray"/>
                        <TextBox x:Name="txtMarque"
                                 Width="150"
                                 Padding="6"/>
                    </StackPanel>

                    <StackPanel Margin="10">
                        <TextBlock Text="Modèle" Foreground="LightGray"/>
                        <TextBox x:Name="txtModele"
                                 Width="150"
                                 Padding="6"/>
                    </StackPanel>

                    <StackPanel Margin="10">
                        <TextBlock Text="Couleur" Foreground="LightGray"/>
                        <TextBox x:Name="txtCouleur"
                                 Width="150"
                                 Padding="6"/>
                    </StackPanel>

                    <StackPanel Margin="10">
                        <TextBlock Text="Places" Foreground="LightGray"/>
                        <TextBox x:Name="txtPlaces"
                                 Width="100"
                                 Padding="6"/>
                    </StackPanel>

                    <StackPanel Margin="10">
                        <TextBlock Text="Immatriculation" Foreground="LightGray"/>
                        <TextBox x:Name="txtImmat"
                                 Width="150"
                                 Padding="6"/>
                    </StackPanel>

                </WrapPanel>

                <!-- BUTTONS -->
                <StackPanel Orientation="Horizontal" Margin="10,20,0,0">

                    <Button Content="➕ Ajouter"
                            Background="#3A86FF"
                            Foreground="White"
                            Padding="12,6"
                            Margin="5"
                            BorderThickness="0"
                            Click="Add_Click" Width="91"/>

                    <Button Content="✏ Modifier"
                            Background="#FFBE0B"
                            Foreground="Black"
                            Padding="12,6"
                            Margin="5"
                            BorderThickness="0"
                            Click="Edit_Click" Width="105"/>

                    <Button Content="🗑 Supprimer"
                            Background="#EF233C"
                            Foreground="White"
                            Padding="12,6"
                            Margin="5"
                            BorderThickness="0"
                            Click="Delete_Click" Width="111"/>

                </StackPanel>

            </StackPanel>
        </Border>

    </Grid>
</Page>