<Page x:Class="Presentation.ReservationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1E1E2F">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🚘" FontSize="26" Margin="0,0,10,0"/>
                <TextBlock Text="Réserver un trajet"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"/>
            </StackPanel>

            <!-- LOGOUT -->
            <Button Grid.Column="1"
                    Content="Logout"
                    Background="#EF233C"
                    Foreground="White"
                    Padding="10,5"
                    BorderThickness="0"
                    Click="Logout_Click"/>
        </Grid>

        <!-- TABLE -->
        <Border Grid.Row="1"
                Background="#2C2C3E"
                CornerRadius="12"
                Padding="10"
                Margin="0,0,0,20">

            <DataGrid x:Name="trajetGrid"
                      AutoGenerateColumns="False"
                      Background="Transparent"
                      Foreground="White"
                      RowBackground="#2C2C3E"
                      AlternatingRowBackground="#262638"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column">

                <!-- HEADER STYLE -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#3A3A50"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Départ" Binding="{Binding AdresseDepart}" Width="*"/>
                    <DataGridTextColumn Header="Arrivée" Binding="{Binding AdresseArrivee}" Width="*"/>
                    <DataGridTextColumn Header="Date"
              Binding="{Binding DateDepart, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}"
                        Width="*"/>
                    <DataGridTextColumn Header="Durée" Binding="{Binding DureeMinutes}" Width="*"/>
                    <DataGridTextColumn Header="Conducteur" Binding="{Binding NomCompletConducteur}" Width="*"/>
                    <DataGridTextColumn Header="Voiture" Binding="{Binding Voiture.Modele}" Width="*"/>
                </DataGrid.Columns>

            </DataGrid>
        </Border>

        <!-- FORM -->
        <Border Grid.Row="2"
                Background="#2C2C3E"
                CornerRadius="12"
                Padding="20">

            <StackPanel>

                <TextBlock Text="Faire une réservation"
                           Foreground="White"
                           FontSize="18"
                           Margin="0,0,0,15"/>

                <StackPanel Orientation="Horizontal">

                    <StackPanel Margin="10">
                        <TextBlock Text="Nb places" Foreground="LightGray"/>
                        <TextBox x:Name="txtPlaces" Width="120" Padding="5"/>
                    </StackPanel>

                    <StackPanel Margin="10">
                        <TextBlock Text="Prix" Foreground="LightGray"/>
                        <TextBox x:Name="txtPrix" Width="120" Padding="5"/>
                    </StackPanel>

                </StackPanel>

                <!-- BUTTONS -->
                <StackPanel Margin="10">

                    <Button Content="✔ Réserver"
                            Background="#3A86FF"
                            Foreground="White"
                            Padding="12"
                            Margin="0,10"
                            BorderThickness="0"
                            Click="Reserve_Click"/>

                    <Button Content="📦 Mes Réservations"
                            Background="#555"
                            Foreground="White"
                            Padding="10"
                            BorderThickness="0"
                            Click="MesReservations_Click"/>

                </StackPanel>

            </StackPanel>
        </Border>

    </Grid>
</Page>