<Page x:Class="Presentation.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1E1E2F">

    <ScrollViewer>
        <Grid>

            <Border Width="420"
                    Padding="30"
                    CornerRadius="15"
                    Background="#2C2C3E"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="40">

                <StackPanel>

                    <TextBlock Text="Créer un compte"
                               FontSize="26"
                               Foreground="White"
                               Margin="0,0,0,20"
                               HorizontalAlignment="Center"/>

                    <!-- Inputs -->
                    <TextBlock Text="Prénom" Foreground="LightGray"/>
                    <TextBox x:Name="txtPrenom" Height="40" Margin="0,5,0,10"/>

                    <TextBlock Text="Nom" Foreground="LightGray"/>
                    <TextBox x:Name="txtNom" Height="40" Margin="0,5,0,10"/>

                    <TextBlock Text="Email" Foreground="LightGray"/>
                    <TextBox x:Name="txtEmail" Height="40" Margin="0,5,0,10"/>

                    <TextBlock Text="Mot de passe" Foreground="LightGray"/>
                    <PasswordBox x:Name="txtPassword" Height="40" Margin="0,5,0,10"/>

                    <TextBlock Text="Téléphone" Foreground="LightGray"/>
                    <TextBox x:Name="txtTel" Height="40" Margin="0,5,0,10"/>

                    <TextBlock Text="Rôle" Foreground="LightGray"/>
                    <ComboBox x:Name="cmbRole" Height="40" Margin="0,5,0,10">
                        <ComboBoxItem Content="Passager"/>
                        <ComboBoxItem Content="Conducteur"/>
                    </ComboBox>

                    <!-- Buttons -->
                    <Button Content="Créer un compte"
                            Background="#8338EC"
                            Foreground="White"
                            Height="40"
                            Click="Register_Click"/>

                    <Button Content="Retour"
                            Background="#444"
                            Foreground="White"
                            Height="35"
                            Margin="0,10"
                            Click="Back_Click"/>

                </StackPanel>

            </Border>

        </Grid>
    </ScrollViewer>
</Page>