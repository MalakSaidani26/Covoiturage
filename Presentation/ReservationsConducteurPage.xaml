<Page x:Class="Presentation.ReservationsConducteurPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1E1E2F">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="📩" FontSize="26" Margin="0,0,10,0"/>
            <TextBlock Text="Réservations reçues"
                       Foreground="White"
                       FontSize="26"
                       FontWeight="Bold"/>
        </StackPanel>

        <!-- TABLE CARD -->
        <Border Grid.Row="1"
                Background="#2C2C3E"
                CornerRadius="12"
                Padding="10"
                Margin="0,0,0,20">

            <DataGrid x:Name="resGrid"
                      AutoGenerateColumns="False"
                      Background="Transparent"
                      Foreground="White"
                      RowBackground="#2C2C3E"
                      AlternatingRowBackground="#262638"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column">

                <!-- HEADER STYLE -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#3A3A50"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- CELL STYLE -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Passager"
                        Binding="{Binding Passager.Prenom}" Width="*"/>

                    <DataGridTextColumn Header="Trajet"
                        Binding="{Binding Trajet.AdresseDepart}" Width="*"/>

                    <DataGridTextColumn Header="Destination"
                        Binding="{Binding Trajet.AdresseArrivee}" Width="*"/>

                    <DataGridTextColumn Header="Places"
                        Binding="{Binding NbPlaces}" Width="*"/>

                    <DataGridTextColumn Header="Prix (TND)"
                        Binding="{Binding Prix}" Width="*"/>

                    <DataGridTextColumn Header="Statut"
                        Binding="{Binding Statut}" Width="*"/>

                </DataGrid.Columns>

            </DataGrid>
        </Border>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left">

            <Button Content="✔ Confirmer"
                    Background="#06D6A0"
                    Foreground="White"
                    Padding="12,6"
                    Margin="5"
                    BorderThickness="0"
                    Click="Confirm_Click" Width="107"/>

            <Button Content="✖ Refuser"
                    Background="#EF233C"
                    Foreground="White"
                    Padding="12,6"
                    Margin="5"
                    BorderThickness="0"
                    Click="Refuse_Click" Width="111"/>

        </StackPanel>

    </Grid>
</Page>